project.manifest = manifest.xml

# Watches with large screens get a sharper launcher icon (resources-hires overrides resources).
round-360x360.resourcePath = $(round-360x360.resourcePath);resources-hires
round-390x390.resourcePath = $(round-390x390.resourcePath);resources-hires
round-416x416.resourcePath = $(round-416x416.resourcePath);resources-hires
round-454x454.resourcePath = $(round-454x454.resourcePath);resources-hires
round-466x466.resourcePath = $(round-466x466.resourcePath);resources-hires
